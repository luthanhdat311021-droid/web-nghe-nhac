# ===================================================
# MUSICWAVE CONFIGURATION ENVIRONMENT VARIABLES
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (Supabase PostgreSQL / Remote Database)
# Option A: Supabase Connection String (Direct Connection - Recommended for simple setup)
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Option B: Supabase Connection Pooling (Transaction Mode & Session Mode)
# DATABASE_URL="postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Persistent media storage (required for uploads on Vercel)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
SUPABASE_STORAGE_BUCKET="musicwave-media"

# Authentication Security
JWT_SECRET="musicwave_super_secret_jwt_key_2026_modern_streaming_app_secure"
JWT_EXPIRES_IN="7d"

# Admin Initial Account
ADMIN_EMAIL="admin@musicwave.com"
ADMIN_PASSWORD="Admin@123456"
ADMIN_USERNAME="MusicWaveAdmin"

# Email SMTP Provider (for Password Reset OTP)
# Optional in Development (uses Dev Console Logger if not provided)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="MusicWave Security <no-reply@musicwave.com>"

# OTP & Password Reset Configuration
OTP_EXPIRES_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
RESET_TOKEN_EXPIRES_MINUTES=10

# Music Pro: 50,000 VND / 30 days. Set the same secret in SePay's API Key webhook settings.
SEPAY_WEBHOOK_KEY=""
SEPAY_ACCOUNT_NUMBER="0819883208"
SEPAY_BANK="MBBank"
