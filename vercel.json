{
  "version": 2,
  "regions": ["bom1"],
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://musicwave-env.eba-jen3axxp.ap-southeast-1.elasticbeanstalk.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "http://musicwave-env.eba-jen3axxp.ap-southeast-1.elasticbeanstalk.com/uploads/:path*"
    },
    {
      "source": "/health",
      "destination": "http://musicwave-env.eba-jen3axxp.ap-southeast-1.elasticbeanstalk.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
