{
  "version": 2,
  "regions": ["bom1"],
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/music-pro/sepay/webhook",
      "destination": "http://musicwave-env.eba-jen3axxp.ap-southeast-1.elasticbeanstalk.com/api/music-pro/sepay/webhook"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
