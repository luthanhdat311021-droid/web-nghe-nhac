
# AWS (used instead of Supabase Storage when S3_BUCKET is set)
AWS_REGION=ap-southeast-1
S3_BUCKET=
# Optional CloudFront domain for media, e.g. https://dxxxx.cloudfront.net
S3_PUBLIC_URL=
# Email via Amazon SES: SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com, SMTP_PORT=587, SES SMTP credentials in SMTP_USER/SMTP_PASS
