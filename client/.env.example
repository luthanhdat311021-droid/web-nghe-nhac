# MusicWave Client Environment Configuration

# 1. Web Local Development (default proxy via Vite):
# VITE_API_URL=/api

# 2. Android Studio Emulator (Connects to backend on localhost:5000 of your PC):
# VITE_API_URL=http://10.0.2.2:5000/api

# 3. Physical Android Device (Connect via local Wi-Fi, replace with your PC IP):
# VITE_API_URL=http://192.168.1.100:5000/api

# 4. Production Cloud Backend (e.g. Render / Railway / Vercel):
# VITE_API_URL=https://your-backend-domain.com/api

VITE_API_URL=
